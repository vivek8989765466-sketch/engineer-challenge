# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pglite database
/data/

# solutions (internal only)
/solutions/

# env example is OK to commit
!.env.example

# internal planning and review files
PLAN.md
CODE-REVIEW*.md
*.docx
CANDIDATE-COMPARISON.md

# OTC internal tooling — never commit to public repos
.semgrep/
.github/workflows/quality-gate.yml
.github/workflows/nightly-scan.yml
.github/workflows/weekly-deep-scan.yml
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
